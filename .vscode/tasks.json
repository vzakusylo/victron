{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Sync sources to flows.json",
			"type": "shell",
			"command": "node tools/flows.js sync",
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Check flows.json",
			"type": "shell",
			"command": "node tools/flows.js check",
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "Run tests",
			"type": "shell",
			"command": "node --test \"tests/*.test.js\"",
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}
