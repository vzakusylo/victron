{
  "intervalMin": 5,
  "durationMin": 60,
  "historyLimit": 10,
  "log": {
    "stop": "\\[info\\]\\s+Stopping (?:flows|modified flows|modified nodes)\\s*$",
    "starting": "\\[info\\]\\s+Starting (?:flows|modified flows|modified nodes)\\s*$",
    "started": "\\[info\\]\\s+Started (?:flows|modified flows|modified nodes)\\s*$"
  },
  "checks": [
    { "id": "tick", "name": "Heat pump automation tick", "source": "context/node/hpa-fn-01/dhw.tickAt", "condition": "fresh", "maxAgeMin": 2, "severity": "FAIL", "graceMin": 2 },
    { "id": "outdoor", "name": "Outdoor average recovered", "source": "context/flow/dhwView", "condition": "finite", "field": "outAvg", "maxAgeMin": 2, "severity": "FAIL", "graceMin": 20 },
    { "id": "curve", "name": "Heating curve coefficients", "source": ["context/flow/dhwView", "context/flow/heatPump.hp", "context/node/hpa-fn-01/heat"], "condition": "ownerCurve", "maxAgeMin": 2, "deviceMaxAgeMin": 5, "allowHeatingOverride": true, "severity": "FAIL", "graceMin": 5 },
    { "id": "curve-offset", "name": "Heating curve rise within cap", "source": ["context/flow/dhwView", "context/flow/heatPump.hp"], "condition": "curveOffset", "maxAgeMin": 2, "deviceMaxAgeMin": 5, "defaultCap": 4, "severity": "FAIL", "graceMin": 5 },
    { "id": "curve-confirmation", "name": "Heating curve confirmation", "source": "context/flow/dhwView", "condition": "confirmed", "maxAgeMin": 2, "pattern": "(?:not confirm|before confirmation)", "holdMin": 10, "severity": "FAIL", "graceMin": 0 },
    { "id": "bms", "name": "BMS watchdog", "source": "context/flow/bmsWatchdogState", "condition": "watchdogOk", "maxAgeMin": 2, "severity": "FAIL", "graceMin": 3 },
    { "id": "battery", "name": "SerialBattery connected", "source": "dbus:com.victronenergy.battery.tty*/Connected", "condition": "equals", "expected": 1, "severity": "FAIL", "graceMin": 3 },
    { "id": "node-errors", "name": "Owned Node-RED errors", "source": "log", "condition": "ownedErrors", "pattern": "\\[error\\] \\[([^\\]]+)\\]\\s*(.*)", "warningSources": [{ "node": "hp-tuya-meter-01", "pattern": "\\bEHOSTUNREACH\\b" }, { "node": "health-file-01", "pattern": "\\bENOENT\\b.*post-deploy-health\\.json" }], "severity": "FAIL", "graceMin": 0 },
    { "id": "gx-notification", "name": "GX notification output", "source": "log", "condition": "ownedErrors", "pattern": "\\[error\\] \\[([^\\]]+)\\]\\s*(.*)", "node": "1a26cadbd6ae5765", "warningSources": [], "severity": "FAIL", "graceMin": 0 },
    { "id": "downtime", "name": "Flows stopped time", "source": "log", "condition": "stoppedTime", "limitMin": 2, "severity": "WARN", "graceMin": 0 },
    { "id": "starts", "name": "Flow starts during deploy", "source": "log", "condition": "startCount", "limit": 1, "severity": "WARN", "graceMin": 0 }
  ]
}
